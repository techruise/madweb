# Node 22+. Copy to .env.local. Never commit real values.
# Canonical public URL, no trailing slash. HTTPS mandatory when REQUIRE_BACKEND=true.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true for launch/Vercel: startup fails unless the complete backend is configured.
# false with all backend vars blank is an explicit frontend-only preview.
REQUIRE_BACKEND=false
# Supabase Project Settings > API. Only these two values may reach browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret server-only key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Random >=32-character secret for IP HMAC; generate: openssl rand -hex 32
RATE_LIMIT_SECRET=
# Optional email notifications. Disabled unless owner approves and supplies a key.
# Resend charges may apply; no account is created by this project.
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=
# VERCEL is set automatically by Vercel. Never trust raw client x-forwarded-for.
# Non-Vercel deployments intentionally share one rate-limit bucket until adapted.
# Local Arena iframe preview only; MUST remain false on public production.
ALLOW_PREVIEW_EMBED=false
